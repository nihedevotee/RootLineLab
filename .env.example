# Rootline Lab Environment Variables Example
# Duplicate this file to .env.local and configure your credentials.

# Contact Form Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rootlinelab.info@gmail.com
SMTP_PASS=your-app-password-here

# Target inbox for contact form submissions (defaults to rootlinelab.info@gmail.com)
# Separate several addresses with commas to deliver to more than one inbox.
CONTACT_EMAIL=rootlinelab.info@gmail.com

# Site URL for metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=https://rootlinelab.com
